---
import type { Lang } from "../i18n/content";

interface Props {
  lang: Lang;
  title: string;
  description: string;
}

const { lang, title, description } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="alternate" hreflang="ja" href="/" />
    <link rel="alternate" hreflang="en" href="/en/" />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --bg: #fbfbfa;
    --fg: #1d1d1f;
    --muted: #5f6368;
    --line: #e3e3e0;
    --accent: #0b6bcb;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #151618;
      --fg: #ececec;
      --muted: #a0a4aa;
      --line: #2c2e33;
      --accent: #6cb2ff;
    }
  }
  * {
    box-sizing: border-box;
  }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--fg);
    font-family: system-ui, -apple-system, "Hiragino Sans", "Noto Sans JP", "Yu Gothic UI", sans-serif;
    line-height: 1.75;
  }
  a {
    color: var(--accent);
  }
</style>
